{
  "name": "goyfield-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/main.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env NODE_ENV=dev nodemon --exec ts-node -r tsconfig-paths/register src/main.ts",
    "build": "tsc && tsc-alias",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "rebuild": "npm run clean && npm run build",
    "start": "node dist/src/main.js",
    "prisma:v2:generate": "prisma generate --schema prisma/v2/schema.prisma",
    "prisma:v2:migrate": "prisma migrate deploy --schema prisma/v2/schema.prisma",
    "prisma:v2:create-migration": "prisma migrate dev --create-only --name dev --schema prisma/v2/schema.prisma",
    "prisma:v1:pg:generate": "prisma generate --schema prisma/v1/postgres/schema.prisma",
    "prisma:v1:pg:migrate": "prisma migrate deploy --schema prisma/v1/postgres/schema.prisma",
    "prisma:v1:pg:create-migration": "prisma migrate dev --create-only --name dev --schema prisma/v1/postgres/schema.prisma",
    "prisma:v1:sqlite:generate": "prisma generate --schema prisma/v1/sqlite/schema.prisma",
    "prisma:v1:sqlite:migrate": "prisma migrate deploy --schema prisma/v1/sqlite/schema.prisma",
    "prisma:v1:sqlite:create-migration": "prisma migrate dev --create-only --name dev --schema prisma/v1/sqlite/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "5.19.0",
    "axios": "^1.16.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.19.0",
    "sharp": "^0.35.3",
    "lru-cache": "^11.5.2",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "nodemon": "^3.1.14",
    "prisma": "5.19.0",
    "rimraf": "^6.1.3",
    "@types/node": "^26.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0"
  }
}

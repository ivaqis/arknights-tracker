generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model FirebaseUser {
    firebaseUid String   @id
    createdAt   DateTime @default(now())

    users User[]
}

model User {
    uid             BigInt   @id @default(autoincrement())
    publicUid       String   @unique
    firebaseUid     String?
    isPrivate       Boolean  @default(false)
    avatarId        String?
    backgroundId    String?
    displayAvatar   Boolean  @default(true)
    uploadCount     Int      @default(0)
    lastUploadReset DateTime @default(now())
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    firebaseUser FirebaseUser? @relation(fields: [firebaseUid], references: [firebaseUid], onDelete: Cascade)

    userGameProfiles UserGameProfile[]

    @@index([firebaseUid])
    @@index([publicUid])
}

model UserGameProfile {
    gameUid  String @id
    serverId String
    uid      BigInt
    data     String // json

    user User @relation(fields: [uid], references: [uid], onDelete: Cascade)

    userBannerProfile        UserBannerProfile?
    userContractLeaderboards UserContractLeaderboard[]
    userMonumentLeaderboards UserMonumentLeaderboard[]

    @@unique([uid, serverId])
    @@index([uid, serverId])
}

model UserContractLeaderboard {
    recordId       String   @id
    gameUid        String
    contractId     String
    indicatorCount Int
    clearTimeSec   Int
    data           String // json
    updatedAt      DateTime @updatedAt

    userGameProfile UserGameProfile @relation(fields: [gameUid], references: [gameUid], onDelete: Cascade)

    @@index([gameUid, contractId])
    @@index([contractId])
}

model UserMonumentLeaderboard {
    gameUid      String
    dungeonId    String
    groupId      String
    isHard       Boolean
    clearTimeSec Int
    data         String // json
    updatedAt    DateTime @updatedAt

    userGameProfile UserGameProfile @relation(fields: [gameUid], references: [gameUid], onDelete: Cascade)

    @@id([gameUid, dungeonId])
    @@index([dungeonId])
    @@index([groupId, isHard])
}

model UserBannerProfile {
    profileId BigInt   @id @default(autoincrement())
    gameUid   String?  @unique
    createdAt DateTime @default(now())

    userGameProfile UserGameProfile? @relation(fields: [gameUid], references: [gameUid])

    generatedTokens         GeneratedToken[]
    userBannerStats         UserBannerStat[]
    userBannerTypeStats     UserBannerTypeStat[]
    userCharBannerTypePulls UserCharBannerTypePulls[]
    userCharBannerPulls     UserCharBannerPulls[]
    userWeaponBannerPulls   UserWeaponBannerPulls[]

    @@index([gameUid])
}

model GeneratedToken {
    token     String @id
    profileId BigInt

    bannerProfile UserBannerProfile @relation(fields: [profileId], references: [profileId])
}

model UserBannerStat {
    profileId   BigInt
    bannerId    String
    unfreePulls Int      @default(0)
    total6      Int      @default(0)
    total5      Int      @default(0)
    won5050     Int      @default(0)
    total5050   Int      @default(0)
    freePulls   Int      @default(0)
    free6       Int      @default(0)
    free5       Int      @default(0)
    freeWin5050 Int      @default(0)
    updatedAt   DateTime @updatedAt

    bannerProfile UserBannerProfile @relation(fields: [profileId], references: [profileId])

    userCharBannerPulls   UserCharBannerPulls[]
    userWeaponBannerPulls UserWeaponBannerPulls[]

    @@id([profileId, bannerId])
    @@index([bannerId])
}

model UserBannerTypeStat {
    profileId   BigInt
    bannerType  String
    unfreePulls Int      @default(0)
    total6      Int      @default(0)
    total5      Int      @default(0)
    won5050     Int      @default(0)
    total5050   Int      @default(0)
    freePulls   Int      @default(0)
    free6       Int      @default(0)
    free5       Int      @default(0)
    freeWin5050 Int      @default(0)
    updatedAt   DateTime @updatedAt

    bannerProfile UserBannerProfile @relation(fields: [profileId], references: [profileId])

    userCharBannerTypePulls UserCharBannerTypePulls[]

    @@id([profileId, bannerType])
    @@index([bannerType])
}

model UserCharBannerTypePulls {
    profileId       BigInt
    bannerType      String
    last6Pull       Int      @default(0)
    last5Pull       Int      @default(0)
    lastWin5050Pull Int      @default(0)
    lastPullTimeTs  BigInt   @default(0)
    updatedAt       DateTime @updatedAt

    bannerProfile  UserBannerProfile  @relation(fields: [profileId], references: [profileId])
    bannerTypeStat UserBannerTypeStat @relation(fields: [profileId, bannerType], references: [profileId, bannerType])

    @@id([profileId, bannerType])
}

model UserCharBannerPulls {
    profileId        BigInt
    bannerId         String
    last6LimitedPull Int      @default(0)
    updatedAt        DateTime @updatedAt

    bannerProfile UserBannerProfile @relation(fields: [profileId], references: [profileId])
    bannerStat    UserBannerStat    @relation(fields: [profileId, bannerId], references: [profileId, bannerId])

    @@id([profileId, bannerId])
}

model UserWeaponBannerPulls {
    profileId       BigInt
    bannerId        String
    last6Pull       Int      @default(0)
    last5Pull       Int      @default(0)
    lastWin5050Pull Int      @default(0)
    lastPullTimeTs  BigInt   @default(0)
    updatedAt       DateTime @updatedAt

    bannerProfile UserBannerProfile @relation(fields: [profileId], references: [profileId])
    bannerStat    UserBannerStat    @relation(fields: [profileId, bannerId], references: [profileId, bannerId])

    @@id([profileId, bannerId])
}

model GlobalBannerStats {
    bannerId    String   @id
    totalUsers  Int      @default(0)
    unfreePulls BigInt   @default(0)
    total6      Int      @default(0)
    total5      Int      @default(0)
    won5050     Int      @default(0)
    total5050   Int      @default(0)
    freePulls   Int      @default(0)
    free6       Int      @default(0)
    free5       Int      @default(0)
    freeWin5050 Int      @default(0)
    updatedAt   DateTime @updatedAt

    globalBannerTimelines   GlobalBannerTimeline[]
    globalPityDistributions GlobalPityDistribution[]
    globalItemStats         GlobalItemStats[]
}

model GlobalBannerTimeline {
    bannerId   String
    date       String // "YYYY-MM-DD"
    pullsCount Int    @default(0)

    globalBannerStats GlobalBannerStats @relation(fields: [bannerId], references: [bannerId])

    @@id([bannerId, date])
}

model GlobalPityDistribution {
    bannerId String
    pity     Int
    rarity   Int
    count    Int    @default(0)

    globalBannerStats GlobalBannerStats @relation(fields: [bannerId], references: [bannerId])

    @@id([bannerId, pity, rarity])
}

model GlobalItemStats {
    bannerId String
    itemId   String
    count    Int    @default(0)

    globalBannerStats GlobalBannerStats @relation(fields: [bannerId], references: [bannerId])

    @@id([bannerId, itemId])
}

model ImportError {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    url       String
    message   String
    stack     String?
    serverId  String?
    solved    Boolean  @default(false)
}

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    uid       BigInt   @id @default(autoincrement())
    createdAt DateTime @default(now())

    generatedTokens         GeneratedToken[]
    userBannerStats         UserBannerStat[]
    userBannerTypeStats     UserBannerTypeStat[]
    userCharBannerTypePulls UserCharBannerTypePulls[]
    userCharBannerPulls     UserCharBannerPulls[]
    userWeaponBannerPulls   UserWeaponBannerPulls[]
}

model GeneratedToken {
    token String @id
    uid   BigInt

    user User @relation(fields: [uid], references: [uid])
}

model UserBannerStat {
    uid        BigInt
    bannerId   String
    totalPulls Int      @default(0)
    total6     Int      @default(0)
    total5     Int      @default(0)
    won5050    Int      @default(0)
    total5050  Int      @default(0)
    updatedAt  DateTime @updatedAt

    user User @relation(fields: [uid], references: [uid])

    userCharBannerPulls   UserCharBannerPulls[]
    userWeaponBannerPulls UserWeaponBannerPulls[]

    @@id([uid, bannerId])
    @@index([bannerId])
}

model UserBannerTypeStat {
    uid        BigInt
    bannerType String
    totalPulls Int      @default(0)
    total6     Int      @default(0)
    total5     Int      @default(0)
    won5050    Int      @default(0)
    total5050  Int      @default(0)
    updatedAt  DateTime @updatedAt

    user User @relation(fields: [uid], references: [uid])

    userCharBannerTypePulls UserCharBannerTypePulls[]

    @@id([uid, bannerType])
    @@index([bannerType])
}

model UserCharBannerTypePulls {
    uid            BigInt
    bannerType     String
    last6Pull      Int      @default(0)
    last5Pull      Int      @default(0)
    lastPullTimeTs BigInt   @default(0)
    updatedAt      DateTime @updatedAt

    user           User               @relation(fields: [uid], references: [uid])
    bannerTypeStat UserBannerTypeStat @relation(fields: [uid, bannerType], references: [uid, bannerType])

    @@id([uid, bannerType])
}

model UserCharBannerPulls {
    uid              BigInt
    bannerId         String
    last6LimitedPull Int      @default(0)
    updatedAt        DateTime @updatedAt

    user       User           @relation(fields: [uid], references: [uid])
    bannerStat UserBannerStat @relation(fields: [uid, bannerId], references: [uid, bannerId])

    @@id([uid, bannerId])
}

model UserWeaponBannerPulls {
    uid             BigInt
    bannerId        String
    last6Pull       Int      @default(0)
    last5Pull       Int      @default(0)
    lastWin5050Pull Int      @default(0)
    lastPullTimeTs  BigInt   @default(0)
    updatedAt       DateTime @updatedAt

    user       User           @relation(fields: [uid], references: [uid])
    bannerStat UserBannerStat @relation(fields: [uid, bannerId], references: [uid, bannerId])

    @@id([uid, bannerId])
}

model GlobalBannerStats {
    bannerId      String   @id
    totalUsers    Int      @default(0)
    totalPulls    BigInt   @default(0)
    total6        Int      @default(0)
    total5        Int      @default(0)
    total6Limited Int      @default(0)
    lost5050      Int      @default(0)
    updatedAt     DateTime @updatedAt
}

model GlobalBannerTimeline {
    bannerId   String
    date       String // "YYYY-MM-DD"
    pullsCount Int    @default(0)

    @@id([bannerId, date])
}

model GlobalPityDistribution {
    bannerId String
    pity     Int
    rarity   Int
    count    Int    @default(0)

    @@id([bannerId, pity, rarity])
}

model GlobalItemStats {
    bannerId String
    itemId   String
    count    Int    @default(0)

    @@id([bannerId, itemId])
}

model ImportError {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    url       String
    message   String
    stack     String?
    serverId  String?
    solved    Boolean  @default(false)
}

  "skills": {
    "basicAttack": {
      "name": "毁伤序列",
      "description": "普通攻击：\n对敌人进行至多5段攻击，造成<@ba.pd>物理伤害</>。作为主控干员时，<#ba.lastcombo>重击</>会造成<@ba.poise>{poise:0}</>点失衡。\n \n下落攻击：\n处于空中时使用普通攻击，会下落并攻击附近敌人，造成<@ba.pd>物理伤害</>。\n \n处决攻击：\n附近有敌人处于失衡状态时使用普通攻击，将处决该敌人，造成大量<@ba.pd>物理伤害</>并恢复一定技力。",
      "batkSeq1Multiplier": "普攻第一段倍率",
      "batkSeq2Multiplier": "普攻第二段倍率",
      "batkSeq3Multiplier": "普攻第三段倍率",
      "batkSeq4Multiplier": "普攻第四段倍率",
      "batkSeq5Multiplier": "普攻第五段倍率",
      "finisherAtkMultiplier": "处决攻击倍率",
      "diveAtkMultiplier": "下落攻击倍率"
    },
    "battleSkill": {
      "name": "构成序列",
      "description": "使用源石技艺冲击前方一定范围内的敌人，造成<@ba.pd>物理伤害</>和<#ba.crush>猛击</>。",
      "dmgMultiplier": "伤害倍率",
      "stagger": "失衡值"
    },
    "comboSkill": {
      "name": "锁闭序列",
      "description": "当小队内其他干员的连携技造成伤害时可以发动。\n冲到敌人身边，对其造成<@ba.pd>物理伤害</>，并附着<#ba.originium>源石结晶</>，在一段时间内将其封印。施加<#ba.physicalstatus>物理异常</>或<#ba.noguard>破防</>会<#ba.consume>消耗</><#ba.originium>源石结晶</>并额外造成<@ba.pd>物理伤害</>。",
      "dmgMultiplier": "伤害倍率",
      "crystalShatteringDmgMultiplier": "击碎结晶伤害倍率",
      "stagger": "失衡值",
      "sealDurationS": "封印时间（秒）",
      "ultimateEnergyGain": "获得终结技能量"
    },
    "ultimate": {
      "name": "轰击序列",
      "description": "使用源石技艺轰击地面，对前方扇形范围内的敌人造成大量<@ba.pd>物理伤害</>。如果敌人身上附着<#ba.originium>源石结晶</>，则<#ba.consume>消耗</><#ba.originium>源石结晶</>并额外造成一次<@ba.pd>物理伤害</>。",
      "dmgMultiplier": "伤害倍率",
      "bonusDmgMultiplier": "额外伤害倍率",
      "stagger": "失衡值"
    },

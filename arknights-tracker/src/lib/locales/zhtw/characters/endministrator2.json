  "skills": {
    "basicAttack": {
      "name": "毀傷序列",
      "description": "普通攻擊：\n對敵人進行最多5段攻擊，造成<@ba.pd>物理傷害</>。作為主控幹員時，<#ba.lastcombo>重擊</>會造成<@ba.poise>{poise:0}</>點失衡。\n\n下墜攻擊：\n處於空中時使用普通攻擊，會下落並攻擊附近敵人，造成<@ba.pd>物理傷害</>。\n\n處決攻擊：\n附近有敵人處於失衡狀態時使用普通攻擊，將處決該敵人，造成大量<@ba.pd>物理傷害</>並回復一定技力。",
      "batkSeq1Multiplier": "普攻第一段倍率",
      "batkSeq2Multiplier": "普攻第二段倍率",
      "batkSeq3Multiplier": "普攻第三段倍率",
      "batkSeq4Multiplier": "普攻第四段倍率",
      "batkSeq5Multiplier": "普攻第五段倍率",
      "finisherAtkMultiplier": "處決攻擊倍率",
      "diveAtkMultiplier": "下墜攻擊倍率"
    },
    "battleSkill": {
      "name": "構成序列",
      "description": "使用源石技藝衝擊前方一定範圍內的敵人，造成<@ba.pd>物理傷害</>和<#ba.crush>猛擊</>。",
      "dmgMultiplier": "傷害倍率",
      "stagger": "失衡值"
    },
    "comboSkill": {
      "name": "鎖閉序列",
      "description": "當小隊內其他幹員的連攜技造成傷害時可以發動。\n衝到敵人身邊，對其造成<@ba.pd>物理傷害</>，並附著<#ba.originium>源石結晶</>，在一段時間內將其封印。施加<#ba.physicalstatus>物理異常</>或<#ba.noguard>破防</>會<#ba.consume>消耗</><#ba.originium>源石結晶</>並額外造成<@ba.pd>物理傷害</>。",
      "dmgMultiplier": "傷害倍率",
      "crystalShatteringDmgMultiplier": "擊碎結晶傷害倍率",
      "stagger": "失衡值",
      "sealDurationS": "封印時間（秒）",
      "ultimateEnergyGain": "獲得終結技能量"
    },
    "ultimate": {
      "name": "轟擊序列",
      "description": "使用源石技藝轟擊地面，對前方扇形範圍內的敵人造成大量<@ba.pd>物理傷害</>。如果敵人身上附著<#ba.originium>源石結晶</>，則<#ba.consume>消耗</><#ba.originium>源石結晶</>並額外造成一次<@ba.pd>物理傷害</>。",
      "dmgMultiplier": "傷害倍率",
      "bonusDmgMultiplier": "額外傷害倍率",
      "stagger": "失衡值"

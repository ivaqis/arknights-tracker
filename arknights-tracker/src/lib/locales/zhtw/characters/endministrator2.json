    "voiceLines": [
      {
        "voId": "chr_0002_endminm_chrbark_squad_01",
        "title": "行動準備1",
        "text": "源石在歌唱。"
      },
      {
        "voId": "chr_0002_endminm_chrbark_squad_02",
        "title": "行動準備2",
        "text": "終末地一定會繼續前行。"
      },
      {
        "voId": "chr_0002_endminm_chrbark_join_01",
        "title": "編入隊伍1",
        "text": "帝江號，我已就位。"
      },
      {
        "voId": "chr_0002_endminm_chrbark_join_02",
        "title": "編入隊伍2",
        "text": "該出發了。"
      },
      {
        "voId": "chr_0002_endminm_chrbark_weap_01",
        "title": "更換武器",
        "text": "還不賴。"
      },
      {
        "voId": "chr_0002_endminm_chrbark_gear_01",
        "title": "更換裝備",
        "text": "這就是工業的成果。"
      },
      {
        "voId": "chr_0002_endminm_chrup_skill_01",
        "title": "解鎖天賦陣列",
        "text": "熟悉的感覺……"
      },
      {
        "voId": "chr_0002_endminm_chrup_level_01",
        "title": "觀看作戰紀錄",
        "text": "我不會再忘記他們的身影。"
      },
      {
        "voId": "chr_0002_endminm_chrup_promt01_01",
        "title": "精英化晉升1",
        "text": "更進一步。"
      },
      {
        "voId": "chr_0002_endminm_chrup_promt02_01",
        "title": "精英化晉升2",
        "text": "我會保護終末地的。"
      },
      {
        "voId": "chr_0002_endminm_chrup_promt03_01",
        "title": "精英化晉升3",
        "text": "過去和現在……必須合二為一。"
      },
      {
        "voId": "chr_0002_endminm_chrup_promt04_01",
        "title": "精英化晉升4",
        "text": "我聽見了她的聲音，像是夢中的呢喃。我常在夢中遇見一片無垠的海，令人悲傷，令人懷念……也讓我再一次下定決心。"
      },
      {
        "voId": "chr_0002_endminm_mono_switch_01",
        "title": "待命1",
        "text": "還在等什麼嗎？"
      },
      {
        "voId": "chr_0002_endminm_mono_switch_02",
        "title": "待命2",
        "text": "源石會開闢道路。"
      },
      {
        "voId": "chr_0002_endminm_sim_gift_recv_01",
        "title": "接收禮物",
        "text": "感謝！"
      },
      {
        "voId": "chr_0002_endminm_explore_point_common_01",
        "title": "發現資源1",
        "text": "那邊是……"
      },
      {
        "voId": "chr_0002_endminm_explore_point_valub_01",
        "title": "發現資源2",
        "text": "那邊有很重要的東西！"
      },
      {
        "voId": "chr_0002_endminm_explore_find_locked_01",
        "title": "發現未探索區域",
        "text": "附近有需要調查的區域。"
      },
      {
        "voId": "chr_0002_endminm_explore_find_danger_01",
        "title": "發現強敵",
        "text": "是強敵，謹慎應對。"
      },
      {
        "voId": "chr_0002_endminm_interact_mine_valub_01",
        "title": "採集礦物1",
        "text": "這些礦物能派上用場。"
      },
      {
        "voId": "chr_0002_endminm_interact_mine_valub_echo2_01",
        "title": "採集礦物2",
        "text": "我也來幫忙。"
      },
      {
        "voId": "chr_0002_endminm_interact_treasure_valub_01",
        "title": "打開儲藏箱",
        "text": "滿載而歸！"
      },
      {
        "voId": "chr_0002_endminm_interact_etherium_01",
        "title": "獲得醚質",
        "text": "熟悉的觸感。"
      },
      {
        "voId": "chr_0002_endminm_interact_blight_break_01",
        "title": "消除侵蝕",
        "text": "確認消除。"
      },
      {
        "voId": "chr_0002_endminm_interact_rest_01",
        "title": "休整",
        "text": "整隊完畢。"
      },
      {
        "voId": "chr_0002_endminm_combat_suppuse_using_01",
        "title": "使用戰術物品1",
        "text": "效果不錯吧！"
      },
      {
        "voId": "chr_0002_endminm_combat_suppuse_getheal_01",
        "title": "使用戰術物品2",
        "text": "感覺很好。"
      },
      {
        "voId": "chr_0002_endminm_combat_remind_danger_01",
        "title": "危險提醒",
        "text": "有危險，注意時機！"
      },
      {
        "voId": "chr_0002_endminm_combat_hurt_lowhp_01",
        "title": "負傷",
        "text": "我還撐得住……"
      },
      {
        "voId": "chr_0002_endminm_combat_dead_01",
        "title": "力竭",
        "text": "抱歉，接下來就交給各位了。"
      },
      {
        "voId": "chr_0002_endminm_combat_remind_praise_01",
        "title": "小隊激勵1",
        "text": "你的招式很俐落。"
      },
      {
        "voId": "chr_0002_endminm_combat_remind_praise_02",
        "title": "小隊激勵2",
        "text": "我們的配合天衣無縫。"
      },
      {
        "voId": "chr_0002_endminm_combat_remind_praise_echo2_01",
        "title": "回應激勵1",
        "text": "過獎了！"
      },
      {
        "voId": "chr_0002_endminm_combat_remind_praise_echo2_02",
        "title": "回應激勵2",
        "text": "嗯，我們越來越有默契了。"
      },
      {
        "voId": "chr_0002_endminm_combat_intobattle_01",
        "title": "作戰開始1",
        "text": "該我們上了。"
      },
      {
        "voId": "chr_0002_endminm_combat_intobattle_echo2_01",
        "title": "作戰開始2",
        "text": "有我在。"
      },
      {
        "voId": "chr_0002_endminm_combat_outbattle_nor_01",
        "title": "作戰勝利1",
        "text": "終末地又前進了一步。"
      },
      {
        "voId": "chr_0002_endminm_combat_outbattle_nor_02",
        "title": "作戰勝利2",
        "text": "辛苦了，各位。"
      },
      {
        "voId": "chr_0002_endminm_combat_outbattle_nor_echo2_01",
        "title": "作戰勝利3",
        "text": "做得不錯！"
      },
      {
        "voId": "chr_0002_endminm_combat_outbattle_hard_01",
        "title": "作戰勝利4",
        "text": "沒事吧？"
      },
      {
        "voId": "chr_0002_endminm_combat_battle_defeat_01",
        "title": "作戰失敗",
        "text": "不要心急，調整完畢後再做打算。"
      },
      {
        "voId": "chr_0002_endminm_mono_attack_last_01",
        "title": "重擊1",
        "text": "嚐嚐這個！"
      },
      {
        "voId": "chr_0002_endminm_mono_attack_last_02",
        "title": "重擊2",
        "text": "看清楚了！"
      },
      {
        "voId": "chr_0002_endminm_mono_skill_nor_01",
        "title": "戰技1",
        "text": "迎擊！"
      },
      {
        "voId": "chr_0002_endminm_mono_skill_nor_02",
        "title": "戰技2",
        "text": "交給我！"
      },
      {
        "voId": "chr_0002_endminm_mono_skill_nor_03",
        "title": "戰技3",
        "text": "擊潰他們！"
      },
      {
        "voId": "chr_0002_endminm_combat_skill_comb_ready_01",
        "title": "連攜技就緒1",
        "text": "隨時可以行動。"
      },
      {
        "voId": "chr_0002_endminm_combat_skill_comb_ready_02",
        "title": "連攜技就緒2",
        "text": "相信我！"
      },
      {
        "voId": "chr_0002_endminm_mono_skill_comb_release_01",
        "title": "連攜技1",
        "text": "接招！"
      },
      {
        "voId": "chr_0002_endminm_mono_skill_comb_release_02",
        "title": "連攜技2",
        "text": "到此為止了！"
      },
      {
        "voId": "chr_0002_endminm_mono_attack_extra_01",
        "title": "處決1",
        "text": "就現在！"
      },
      {
        "voId": "chr_0002_endminm_mono_attack_extra_02",
        "title": "處決2",
        "text": "找到破綻了。"
      },
      {
        "voId": "chr_0002_endminm_mono_skill_ultimate_01",
        "title": "終結技1",
        "text": "沒有第二次機會。"
      },
      {
        "voId": "chr_0002_endminm_mono_skill_ultimate_02",
        "title": "終結技2",
        "text": "你將邁向終結。"
      },
      {
        "voId": "chr_0002_endminm_mono_skill_ultimate_03",
        "title": "終結技3",
        "text": "鬧劇該結束了！"
      }
    ]
  },
